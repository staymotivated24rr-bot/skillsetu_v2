# PostgreSQL / Neon connection string.
# Never commit a real password. Copy this file to .env and replace the placeholder locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Isolated adaptive Python pilot; keep disabled on public deployments.
DIAGNOSTIC_V2_ENABLED=false

# Unapproved 360-item bank: OFF. Local DB only, never hosted/VERCEL.
DIAGNOSTIC_STARTER_V3_PREVIEW=false
DIAGNOSTIC_DRAFT_ENV=disabled
DIAGNOSTIC_STARTER_V3_DEFAULT=false

# Local-only interactive learning demonstration; never enabled on hosted VERCEL.
LEARNING_STUDIO_ENABLED="false"
